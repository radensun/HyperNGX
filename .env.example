# Disalin ke .env saat pengembangan lokal.
# sqlx memverifikasi query ke database saat kompilasi, jadi variabel ini
# harus menunjuk database yang sudah dimigrasikan sebelum `cargo build`.
DATABASE_URL=postgres:///hyperngx_build

# Runtime (produksi memakai default: unix socket + peer auth)
HYPERNGX_DATABASE_URL=postgres:///hyperngx?host=/var/run/postgresql
HYPERNGX_SUPERVISOR_SOCKET=/run/hyperngx/supervisor.sock
RUST_LOG=info
